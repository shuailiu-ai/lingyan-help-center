# Public site URL used for canonical links, Open Graph metadata, robots.txt and sitemap.xml.
# GitHub Pages project site for this repository:
NEXT_PUBLIC_SITE_URL=https://shuailiu-ai.github.io/lingyan-help-center

# Required when the site is served from a subpath. Project Pages use /<repository>.
# Leave empty for local development and for a custom domain served from the domain root.
NEXT_PUBLIC_BASE_PATH=/lingyan-help-center
